{
  "devDependencies": {
    "@iconify/json": "^2.2.314",
    "@iconify/tailwind": "^1.2.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^3.4.14"
  },
  "scripts": {
    "build-css": "tailwindcss build -i ./css/main.css -o ./css/bundle.css",
    "watch-css": "tailwindcss build -i ./css/main.css -o ./css/bundle.css --watch",
    "dev": "concurrently --kill-others \"npm run watch-css\" ",
    "build": "concurrently --kill-others \"npm run build-css\""
  },
  "dependencies": {
    "flyonui": "^1.3.0",
    "tailwind-scrollbar": "^3.1.0"
  }
}
